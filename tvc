def stand_open_required() -> list[str]:
    """Dotted names of the MEASURE params sequencer.cpp's measureGateOk() makes ARM wait for."""
    src = (REPO / "firmware" / "src" / "flight" / "sequencer.cpp").read_text()
    start = src.find("bool measureGateOk")
    end = src.find("return ok;", start)
    return re.findall(r'\{"([a-z0-9_.]+)",\s*params::', src[start:end])


def measure_values() -> dict[str, bool]:
    """dotted name -> still MEASURE, for every param in params.yaml."""
    out: dict[str, bool] = {}
    for section, body in load_params().items():
        if isinstance(body, dict):
            for k, v in body.items():
                out[f"{section}.{k}"] = (v == "MEASURE")
    return out


def cmd_ready(args) -> int:
    gates: list[tuple[str, str, str | None]] = []

    def gate(color: str, msg: str, nxt: str | None = None):
        gates.append((color, msg, nxt))
        print(f"{_tag(color)} {msg}")
        if nxt:
            print(f"       next: {nxt}")
        sys.stdout.flush()

    print("Checking the pre-fire gates. This runs the test suite and a radio test, so "
          "it takes a few minutes.\n")

    # 1. tests
    tr = Results(quiet=True)
    if run_tests(tr):
        gate("GREEN", "tests: native, parity, codec and GUI offscreen tests all pass")
    else:
        first = next((m for k, m, _ in tr.lines if k == "FAIL"), "a test step failed")
        gate("RED", f"tests: {first}", "./tvc test shows the full output")

    # 2. boards on the current hash, 3. SELFTEST
    probe = Results(quiet=True)
    teensy_dev = resolve_port(probe, "teensy", args.teensy_port)
    st = None
    if teensy_dev:
        holders = port_holders(teensy_dev)
        if holders:
            gate("RED", f"Teensy port {teensy_dev} is busy: held by {holders[0][1]}",
                 "close that program, then run ./tvc ready again")
        else:
            try:
                con = Console(teensy_dev)
                st = query_status(con)
                con.close()
            except OSError:
                st = None
    head = git_head()
    teensy_msg, teensy_ok = "Teensy not detected", False
    if st and st.get("fw"):
        teensy_ok, why = hash_is_current(st["fw"])
        teensy_msg = f"Teensy firmware {why}"
    elif st:
        teensy_msg = "Teensy firmware predates the fw= field"
    elif teensy_dev:
        teensy_msg = "Teensy did not answer STATUS"

    fprobe = Results(quiet=True)
    feather_dev = resolve_port(fprobe, "feather", args.feather_port)
    stamp = load_state().get("feather")
    feather_ok, feather_msg = False, "Feather not detected: try double-tap reset"
    if feather_dev and stamp:
        feather_ok, why = hash_is_current(stamp["hash"])
        feather_msg = f"Feather bridge {why} (from the upload stamp)"
    elif feather_dev:
        feather_msg = "Feather present but there is no upload stamp: flash it with this tool"

    if teensy_ok and feather_ok:
        gate("GREEN", f"both boards on current firmware (HEAD {head})")
    else:
        parts = []
        if not teensy_ok:
            parts.append(teensy_msg)
        if not feather_ok:
            parts.append(feather_msg)
        gate("RED", "boards on current hash: " + "; ".join(parts),
             "./tvc flash all" if (teensy_dev and feather_dev) else "./tvc ports")

    if st is not None:
        hard = st["faults"] & ~(1 << 0) & ~(1 << 7)  # MEASURE_MISSING and LOOP_OVERRUN
        if st["state"] in ("IDLE", "ARMED") and hard == 0:
            gate("GREEN", f"SELFTEST: Teensy is {st['state']} with no hard fault bits "
                          f"(fault_bits 0x{st['faults']:04X})")
        else:
            gate("RED", f"SELFTEST: Teensy is {st['state']}, fault_bits 0x{st['faults']:04X}",
                 "./tvc selftest shows which check failed")
    else:
        gate("RED", "SELFTEST: no Teensy status to read", "./tvc ports, then ./tvc selftest")

    # 4. radio link
    link_ok = False
    if feather_dev:
        if port_holders(feather_dev):
            gate("RED", f"radio link: {feather_dev} is busy",
                 "close the ground station, then run ./tvc ready again")
        else:
            lr = Results(quiet=True)
            print(f"       (running the {args.link_seconds:.0f} s radio test...)")
            res = measure_link(feather_dev, args.link_seconds, lr)
            if res is not None and report_link(res, lr):
                link_ok = True
                gate("GREEN", f"radio link: loss {res['loss_pct']:.1f}%, "
                              f"{res['counts']['TELEM']} TELEM in {res['elapsed']:.0f} s")
            else:
                why = next((m for k, m, _ in lr.lines if k == "FAIL"), "link test failed")
                gate("RED", f"radio link: {why}", "./tvc link shows the full report")
    else:
        gate("RED", "radio link: Feather not detected: try double-tap reset", "./tvc ports")

    # 5. uplink ARM / ABORT ACK round trip
    if feather_dev and link_ok:
        ok, msg, nxt = ack_roundtrip(feather_dev)
        gate("GREEN" if ok else "RED", f"uplink ARM/ABORT ACK round trip: {msg}",
             None if ok else nxt)
    else:
        gate("RED", "uplink ARM/ABORT ACK round trip: not tried, the radio link gate is not green",
             "fix the radio link first")

    # 6. MEASURE values blocking ARM
    required = stand_open_required()
    values = measure_values()
    blocking = [n for n in required if values.get(n, True)]
    others = sorted(n for n, m in values.items() if m and n not in required)
    if blocking:
        gate("RED", "MEASURE values still blocking ARM: " + ", ".join(blocking),
             "measure them (BRINGUP.md section 'MEASURE'), put them in params.yaml, "
             "then ./tvc flash teensy")
    else:
        gate("GREEN", "no MEASURE value blocks ARM in STAND_OPEN")
    if others:
        print("       also still MEASURE, not needed for STAND_OPEN: " + ", ".join(others))

    # 7. DRY_RUN reaches SAFE (manual)
    gate("MANUAL", "DRY_RUN reaches SAFE: with the LED and 1 kOhm in place of the igniter, run "
                   "the dry-run sequence (BRINGUP.md step 9) and confirm the LED pulses once "
                   "and the state ends at SAFE")

    # permanent
    gate("RED", PERMANENT_RED)

    reds = sum(1 for c, _, _ in gates if c == "RED")
    manual = sum(1 for c, _, _ in gates if c == "MANUAL")
    print()
    if reds == 0 and manual == 0:
        print("READY")
        return 0
    print(f"NOT READY: {reds} RED, {manual} MANUAL")
    return 1


# ---- main --------------------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="tvc", description=__doc__.split("\n\n")[0],
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("ports", help="list the Teensy and the Feather by name")
    sub.add_parser("test", help="native tests, parity, codec tests, GUI offscreen tests")

    f = sub.add_parser("flash", help="build + upload, then check what the board reports")
    f.add_argument("target", choices=["teensy", "feather", "all"])
    f.add_argument("--port", help="serial device (single-board flash only)")

    m = sub.add_parser("monitor", help="watch a board")
    m.add_argument("target", choices=["teensy", "feather"])
    m.add_argument("--port")

    s = sub.add_parser("selftest", help="run SELFTEST on the Teensy over USB")
    s.add_argument("--port")

    lk = sub.add_parser("link", help="receive-only radio test through the Feather")
    lk.add_argument("--port")
    lk.add_argument("--teensy-port", help="Teensy USB console, for loop_us max and TX counters "
                                          "(found automatically if one Teensy is plugged in)")
    lk.add_argument("--seconds", type=float, default=60.0)

    g = sub.add_parser("gs", help="launch the ground station")
    grp = g.add_mutually_exclusive_group()
    grp.add_argument("--sim", action="store_true", help="virtual vehicle (default)")
    grp.add_argument("--replay", metavar="FILE", help="replay an SD log or ground log")
    grp.add_argument("--live", action="store_true", help="through the Feather bridge")
    g.add_argument("--port", help="--live: Feather serial device")

    rd = sub.add_parser("ready", help="pre-fire checklist: GREEN / RED / MANUAL")
    rd.add_argument("--teensy-port")
    rd.add_argument("--feather-port")
    rd.add_argument("--link-seconds", type=float, default=60.0)
    return p


def main() -> int:
    ensure_venv()
    args = build_parser().parse_args()
    os.chdir(REPO)
    handlers = {"ports": cmd_ports, "test": cmd_test, "flash": cmd_flash,
                "monitor": cmd_monitor, "selftest": cmd_selftest, "link": cmd_link,
                "gs": cmd_gs, "ready": cmd_ready}
    try:
        return handlers[args.cmd](args)
    except KeyboardInterrupt:
        print("\ninterrupted")
        return 130


if __name__ == "__main__":
    sys.exit(main())
