def cmd_monitor(args) -> int:
    r = Results()
    dev = resolve_port(r, args.target, args.port)
    if not dev:
        return 1
    holders = port_holders(dev)
    if holders:
        pid, name, _ = holders[0]
        r.failed(f"{dev} is busy: held by {name} (pid {pid})",
                 "close that program, then run this again")
        return 1
    if args.target == "feather":
        print(f"decoding radio frames from {dev} (Ctrl-C to stop)")
        os.execv(sys.executable,
                 [sys.executable, str(REPO / "tools" / "telem_cli.py"), "--port", dev])
    import serial
    import threading
    ser = serial.Serial(dev, 115200, timeout=0.1)
    stop = threading.Event()

    def reader():
        while not stop.is_set():
            try:
                data = ser.read(256)
            except (OSError, serial.SerialException):
                return
            if data:
                sys.stdout.write(data.decode(errors="replace"))
                sys.stdout.flush()

    threading.Thread(target=reader, daemon=True).start()
    print(f"teensy console on {dev} at 115200. Type a command and press Enter: STATUS, "
          "SELFTEST, ABORT, HELP. Ctrl-C to quit.")
    try:
        if sys.stdin.isatty():
            for line in sys.stdin:
                ser.write(line.strip().encode() + b"\n")
        else:
            while True:
                time.sleep(1)
    except KeyboardInterrupt:
        pass
    finally:
        stop.set()
        time.sleep(0.2)
        ser.close()
    return 0


# ---- selftest ----------------------------------------------------------------------------------

SELFTEST_LINE_RE = re.compile(r"^\[(PASS|FAIL|SKIP|WARN)\]\s+(.*)$")

# (label, regex that finds the firmware's line for it, what to do if it fails)
SELFTEST_CHECKS = [
    ("IMU (MPU-6050 answers)", r"IMU WHO_AM_I",
     "check the MPU-6050: 3.3 V, GND, SDA to pin 18, SCL to pin 19, address 0x68"),
    ("SD card", r"^SD\b",
     "reseat the SD card (FAT32 or exFAT, at least 64 MB free); the card is the primary log"),
    ("flash mirror (LittleFS)", r"LittleFS",
     "reflash with ./tvc flash teensy; the program-flash mirror did not mount"),
    ("radio init", r"radio init",
     "check the RFM95W: CS pin 10, IRQ pin 8, RST pin 9, SPI 11/12/13, 3.3 V, antenna "
     "attached; then power-cycle the Teensy (radio init only runs at boot)"),
    ("encoders (both AS5600)", r"^encoders? ",
     "check the AS5600 boards: #1 on SDA 17 / SCL 16, #2 on SDA 25 / SCL 24, address 0x36, "
     "magnets in place"),
    ("servos (sweep +-5 deg, encoder confirms)", r"servo sweep",
     "check servo power and linkage; the encoder must move the way params.yaml sign_x / "
     "sign_y says"),
    ("load cell (HX711)", r"HX711",
     "check the HX711: DOUT pin 6, SCK pin 7, 3.3 V, load-cell leads"),
    ("IMU axis remap determinant", r"determinant",
     "the R_B<-S remap in imu.cpp is not a signed permutation; fix it before anything else"),
]


def run_selftest_on(con: Console, r: Results) -> bool:
    st = query_status(con)
    if st is None:
        r.failed("no reply from the Teensy console",
                 "make sure it runs teensy_flight (./tvc flash teensy) and that nothing else "
                 "has the port open")
        return False
    if st.get("fw"):
        r.info(f"Teensy firmware {st['fw']}, state {st['state']}")
    else:
        r.warn("this firmware predates the fw= field in STATUS and has no radio check",
               "reflash: ./tvc flash teensy")
    state = st["state"]
    if state in LIVE_STATES:
        r.failed(f"the vehicle is {state}: not running SELFTEST",
                 "type ABORT in ./tvc monitor teensy first (SELFTEST is IDLE or FAULT only)")
        return False
    if state == "SAFE":
        r.info("state is SAFE: sending RESET to return to IDLE first")
        con.send("RESET")
        con.collect(lambda ln: ">> IDLE" in ln, 3.0)

    r.info("SELFTEST sweeps both servos +-5 deg and samples the gyro for 2 s: keep the stand "
           "still and the linkage clear")
    con.send("SELFTEST")
    lines, done = con.collect(
        lambda ln: "SELFTEST: complete" in ln or "SELFTEST: FAULT" in ln, timeout=90.0)
    if not done:
        r.failed("SELFTEST did not finish within 90 s",
                 "open ./tvc monitor teensy to see where it stopped; an SD card that will "
                 "not preallocate is the usual cause")
        return False

    results = [(m.group(1), m.group(2)) for ln in lines if (m := SELFTEST_LINE_RE.match(ln))]
    missing = [ln.split("MISSING (still MEASURE):")[1].strip() for ln in lines
               if "MISSING (still MEASURE):" in ln]
    for label, pattern, nxt in SELFTEST_CHECKS:
        hit = next(((s, t) for s, t in results if re.search(pattern, t)), None)
        if hit is None:
            if label == "radio init" or "determinant" in label:
                r.failed(f"{label}: the firmware did not report this check",
                         "reflash the current firmware: ./tvc flash teensy")
            continue
        status, text = hit
        if status == "PASS":
            detail = f" (logging to {text[6:]})" if text.startswith("SD -> ") else ""
            r.passed(f"{label}{detail}")
        elif status == "SKIP":
            r.failed(f"{label}: not run, an earlier check failed",
                     "fix the failures above, then run ./tvc selftest again")
        else:
            r.failed(f"{label}: {text}", nxt)
    if missing:
        r.warn("MEASURE values still unset (these block ARM, not SELFTEST): "
               + ", ".join(missing),
               "fill them in params.yaml, then ./tvc flash teensy")
    return r.ok


def cmd_selftest(args) -> int:
    r = Results()
    dev = resolve_port(r, "teensy", args.port)
    if not dev:
        return 1
    holders = port_holders(dev)
    if holders:
        pid, name, _ = holders[0]
        r.failed(f"{dev} is busy: held by {name} (pid {pid})",
                 "close that program (or let ./tvc flash close it), then run this again")
        return 1
    try:
        con = Console(dev)
    except OSError as exc:
        r.failed(f"could not open {dev}: {exc}", "unplug and replug the Teensy, then retry")
        return 1
    try:
        ok = run_selftest_on(con, r)
    finally:
        con.close()
    print()
    print("SELFTEST PASSED" if ok else f"SELFTEST: {r.fails} FAILED")
    return 0 if ok else 1


# ---- link ----------------------------------------------------------------------------------

def measure_link(dev: str, seconds: float, r: Results) -> dict | None:
    """Receive-only radio test through the Feather. Sends nothing."""
    import serial
    sys.path.insert(0, str(REPO / "protocol"))
    import telem_codec as tc

    params = load_params()
    telem_hz = float(params["telemetry"]["telem_rate_hz"])
    status_hz = float(params["telemetry"]["status_rate_hz"])
    tables = tc.Tables.load(REPO)
    parser = tc.FrameParser(bridge_trailer=True)
    try:
        ser = serial.Serial(dev, 115200, timeout=0.05)
    except (OSError, serial.SerialException) as exc:
        r.failed(f"could not open {dev}: {exc}", "close whatever holds it, or ./tvc ports")
        return None

    counts: Counter = Counter()
    rssi: list[int] = []
    snr: list[int] = []
    overruns: list[int] = []
    telem_times: list[float] = []
    t0 = time.time()
    try:
        while time.time() - t0 < seconds:
            for fr in parser.feed(ser.read(512)):
                now = time.time()
                try:
                    kind = tc.PacketType(fr.ptype).name
                except ValueError:
                    kind = f"type_{fr.ptype}"
                counts[kind] += 1
                if fr.rssi is not None:
                    rssi.append(fr.rssi)
                    snr.append(fr.snr)
                if kind == "TELEM":
                    telem_times.append(now)
                if kind == "STATUS":
                    try:
                        overruns.append(tc.decode_status(fr.payload, tables)["loop_overrun_count"])
                    except Exception:  # noqa: BLE001 - a bad payload is counted by CRC anyway
                        pass
    finally:
        ser.close()
    elapsed = time.time() - t0
    exp_telem = telem_hz * elapsed
    got = counts["TELEM"]
    return {
        "elapsed": elapsed, "counts": counts, "telem_expected": exp_telem,
        "status_expected": status_hz * elapsed,
        "loss_pct": max(0.0, 100.0 * (1.0 - got / exp_telem)) if exp_telem else 100.0,
        "crc_errors": parser.crc_errors, "rssi": rssi, "snr": snr, "overruns": overruns,
        "max_gap_ms": max((b - a) * 1000 for a, b in zip(telem_times, telem_times[1:]))
        if len(telem_times) > 1 else None,
    }


NOMINAL_TICK_US = 3333      # 300 Hz loop; params.yaml control.loop_hz
LOOP_STALL_WARN_US = 10_000  # three missed ticks; a TX that blocks shows up as its whole airtime


def open_vehicle_console(r: Results, override: str | None) -> "Console | None":
    """The Teensy's USB console for the loop counters, or None (with an INFO line saying why).
    The radio part of the test needs only the Feather, so a missing Teensy is not a failure:
    a range test usually runs the vehicle on its battery."""
    dev = override or os.environ.get("TVC_TEENSY_PORT")
    if not dev:
        teensy, _ = find_boards()
        if len(teensy) != 1:
            r.info("no single Teensy on USB, so vehicle loop timing and skipped-TX counts are "
                   "not read (plug it into this Mac, or send STATUS in ./tvc monitor teensy)")
            return None
        dev = teensy[0].device
    holders = port_holders(dev)
    if holders:
        r.info(f"{dev} is held by {holders[0][1]} (pid {holders[0][0]}): vehicle loop timing "
               "and skipped-TX counts are not read")
        return None
    try:
        return Console(dev)
    except OSError as exc:
        r.info(f"could not open {dev} ({exc}): vehicle loop timing is not read")
        return None


def start_vehicle_window(con: "Console", r: Results) -> bool:
    """CLEARSTATS so loop_us max and the TX counters cover only this test, not the boot SELFTEST."""
    con.ser.reset_input_buffer()
    con._buf = b""
    con.send("CLEARSTATS")
    _, ok = con.collect(lambda ln: "stats cleared" in ln, 2.0)
    if not ok:
        r.warn("the Teensy did not answer CLEARSTATS, so loop_us max may include boot-time stalls",
               "reflash it with ./tvc flash teensy (older firmware has no CLEARSTATS)")
    return ok


def report_airtime_budget(r: Results) -> None:
    sys.path.insert(0, str(REPO / "tools"))
    import lora_airtime as la
    s = la.load_settings()
    b = la.budget(s["sf"], s["bw_khz"], s["cr"], s["telem_hz"], s["status_hz"])
    t, st = b["rows"]["TELEM"], b["rows"]["STATUS"]
    msg = (f"airtime budget (params.yaml): SF{s['sf']} BW{s['bw_khz']} kHz, TELEM "
           f"{t['air_us'] / 1000:.1f} ms + STATUS {st['air_us'] / 1000:.1f} ms, downlink duty "
           f"{b['duty_pct']:.1f}%")
    if b["duty_pct"] > la.DUTY_LIMIT_PCT:
        r.warn(msg, "ground/venv/bin/python tools/lora_airtime.py shows the next step")
    else:
        r.info(msg)


def report_vehicle(vehicle: dict, res: dict, r: Results) -> None:
    """Loop timing and TX counters the Teensy reported over USB after the test window."""
    if vehicle.get("loop_us_max") is None:
        r.warn("this firmware does not report loop_us_max / tx_skipped",
               "reflash: ./tvc flash teensy")
        return
    peak = vehicle["loop_us_max"]
    line = (f"vehicle loop: longest tick period {peak} us (nominal {NOMINAL_TICK_US} us), "
            f"{vehicle['tx_skipped']} TELEM skipped while a frame was on the air, "
            f"{vehicle['tx_timeouts']} stuck TX cleared")
    if peak > LOOP_STALL_WARN_US:
        sys.path.insert(0, str(REPO / "tools"))
        import lora_airtime as la
        s = la.load_settings()
        telem_ms = la.budget(s["sf"], s["bw_khz"], s["cr"], s["telem_hz"],
                             s["status_hz"])["rows"]["TELEM"]["air_us"] / 1000
        r.warn(line, f"something held the flight loop for {peak / 1000:.0f} ms. One TELEM "
               f"frame is {telem_ms:.0f} ms on air: if the stall is about that long the board "
               "still runs the old blocking radio code (./tvc flash teensy); otherwise look at "
               "SD writes (logging_sd.cpp), or a SELFTEST run inside the window")
    else:
        r.info(line)
    if vehicle["tx_timeouts"]:
        r.warn(f"{vehicle['tx_timeouts']} transmissions never reported done and were cleared by "
               "the timeout",
               "check the RFM95W IRQ wire on pin 8 and its 3.3 V supply")
    if vehicle["tx_skipped"]:
        expected = max(1.0, res["telem_expected"])
        r.warn(f"{vehicle['tx_skipped']} TELEM frames ({100.0 * vehicle['tx_skipped'] / expected:.1f}%) "
               "were skipped because the radio was still sending: the channel is saturated",
               "ground/venv/bin/python tools/lora_airtime.py shows the duty cycle and the next "
               "bandwidth step")


def report_link(res: dict, r: Results, limit_pct: float = 2.0,
                vehicle: dict | None = None) -> bool:
    c = res["counts"]
    el = res["elapsed"]
    got = c["TELEM"]
    if got == 0:
        r.failed(f"no TELEM packets in {el:.0f} s",
                 "power the vehicle (the Teensy transmits from boot), attach both antennas, "
                 "and check ./tvc selftest says radio init PASS")
        return False
    r.info(f"{got} TELEM ({got / el:.1f}/s), {c['STATUS']} STATUS ({c['STATUS'] / el:.1f}/s), "
           f"{c['EVENT']} EVENT, {c['ACK']} ACK in {el:.0f} s")
    loss = res["loss_pct"]
    if loss < limit_pct:
        r.passed(f"loss {loss:.1f}% (limit {limit_pct:.0f}%, expected "
                 f"{res['telem_expected']:.0f} TELEM)")
    else:
        r.failed(f"loss {loss:.1f}% (limit {limit_pct:.0f}%)",
                 "move the antennas apart from metal and cables, keep line of sight, and "
                 "retest at the real stand distance; if loss stays high see BRINGUP.md")
    if res["crc_errors"]:
        r.warn(f"{res['crc_errors']} frames failed CRC and were dropped",
               "interference or a weak signal: check RSSI below and antenna placement")
    else:
        r.passed("0 CRC errors")
    if res["rssi"]:
        n = len(res["rssi"])
        r.info(f"RSSI mean {sum(res['rssi']) / n:.0f} dBm (min {min(res['rssi'])}, "
               f"max {max(res['rssi'])}), SNR mean {sum(res['snr']) / n:.1f} dB")
    if res["max_gap_ms"] is not None:
        r.info(f"longest gap between TELEM packets: {res['max_gap_ms']:.0f} ms")
    if len(res["overruns"]) >= 2 and res["overruns"][-1] > res["overruns"][0]:
        r.warn(f"the vehicle's loop-overrun count rose by "
               f"{res['overruns'][-1] - res['overruns'][0]} during the test",
               "see the vehicle loop line below for the longest tick, and BRINGUP.md, known gaps")
    if vehicle is not None:
        report_vehicle(vehicle, res, r)
    return r.ok


def cmd_link(args) -> int:
    r = Results()
    dev = resolve_port(r, "feather", args.port)
    if not dev:
        return 1
    holders = port_holders(dev)
    if holders:
        pid, name, _ = holders[0]
        r.failed(f"{dev} is busy: held by {name} (pid {pid})",
                 "close that program (the ground station holds the port too), then retry")
        return 1
    r.info(f"listening on {dev} for {args.seconds:.0f} s; this sends nothing over the radio")
    report_airtime_budget(r)
    con = open_vehicle_console(r, args.teensy_port)
    if con is not None:
        start_vehicle_window(con, r)  # only text on the Teensy's own USB console
    try:
        res = measure_link(dev, args.seconds, r)
        vehicle = query_status(con) if (con is not None and res is not None) else None
    finally:
        if con is not None:
            con.close()
    if res is None:
        return 1
    if con is not None and vehicle is None:
        r.warn("the Teensy console did not answer STATUS after the test",
               "run STATUS in ./tvc monitor teensy to read loop_us_max and tx_skipped")
    ok = report_link(res, r, vehicle=vehicle)
    print()
    print("LINK PASSED" if ok else "LINK FAILED")
    return 0 if ok else 1


# ---- uplink ACK round trip (used by ready) -----------------------------------------------------

def ack_roundtrip(dev: str) -> tuple[bool, str, str]:
    """Send ARM then ABORT then DISARM through the Feather and look for ACKs.

    Returns (ok, message, next). ARM is only sent while the vehicle reports its arm switch
    OPEN, so the vehicle must refuse it; an ACK carrying that refusal is the proof of the
    round trip, and nothing can arm.
    """
    import serial
    sys.path.insert(0, str(REPO / "protocol"))
    import telem_codec as tc

    tables = tc.Tables.load(REPO)
    parser = tc.FrameParser(bridge_trailer=True)
    try:
        ser = serial.Serial(dev, 115200, timeout=0.05)
    except (OSError, serial.SerialException) as exc:
        return False, f"could not open {dev}: {exc}", "close whatever holds it"

    def pump(until, timeout):
        end = time.time() + timeout
        while time.time() < end:
            for fr in parser.feed(ser.read(512)):
                if until(fr):
                    return fr
        return None

    try:
        telem = pump(lambda fr: fr.ptype == tc.PacketType.TELEM, 4.0)
        if telem is None:
            return False, "no downlink: no TELEM in 4 s", \
                "run ./tvc link first; the ACK test needs a working downlink"
        flags = tc.decode_telem(telem.payload)["flags"]
        if flags & tc.FLAG_ARM_SWITCH_CLOSED:
            return False, "the arm switch is closed, so the ARM test is not run", \
                "open the physical arm switch, then run ./tvc ready again (the test sends ARM)"

        seq = int(time.time()) & 0x7FFF

        def send(ptype, value=None):
            nonlocal seq
            seq = (seq + 1) & 0xFFFF
            ser.write(tc.encode_frame(ptype, tc.encode_uplink(ptype, seq, value)))
            ser.flush()
            return seq

        def ack_for(s):
            def match(fr):
                if fr.ptype != tc.PacketType.ACK:
                    return False
                return tc.decode_ack(fr.payload)["seq"] == s
            fr = pump(match, 2.5)
            return tc.decode_ack(fr.payload) if fr else None

        arm = ack_for(send(tc.PacketType.ARM))
        abort = ack_for(send(tc.PacketType.ABORT))
        send(tc.PacketType.DISARM)  # SAFE -> IDLE again, so the bench is left as found
        if arm is None or abort is None:
            missing = " and ".join(n for n, a in (("ARM", arm), ("ABORT", abort)) if a is None)
            return False, f"no ACK for {missing} within 2.5 s", \
                ("the vehicle firmware does not dispatch ARM/ABORT from radio yet (it only "
                 "tracks HEARTBEAT, SPEC.md 4.7); it needs radio uplink dispatch in "
                 "sequencer.cpp")
        if arm["result"] == 0:
            return False, "the vehicle ACCEPTED ARM with the arm switch reported open", \
                "stop: the arm-switch sense and the ARM path disagree; check ARM_SENSE_PIN 15"
        if abort["result"] != 0:
            return False, f"ABORT was ACKed but with result {abort['result_name']}", \
                "ABORT must always succeed: read radio uplink handling in sequencer.cpp"
        return True, (f"ARM ACKed ({arm['result_name']}), ABORT ACKed (OK)"), ""
    finally:
        ser.close()


