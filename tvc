#!/usr/bin/env python3
"""tvc: build, flash, and test the TVC rocket from one place. BRINGUP.md has the order to run
these in.

    ./tvc ports                      list the Teensy and the Feather by name
    ./tvc test                       native tests, parity, codec tests, GUI offscreen tests
    ./tvc flash teensy|feather|all   build + upload, then check what the board reports
    ./tvc monitor teensy|feather     watch a board
    ./tvc selftest                   run SELFTEST on the Teensy over USB, one line per check
    ./tvc link                       60 s radio test through the Feather
    ./tvc gs [--sim|--replay F|--live]   ground station
    ./tvc ready                      pre-fire checklist: GREEN / RED / MANUAL

Every command prints PASS / FAIL / WARN / INFO lines, and after a FAIL one "next:" line saying
what to do. Nothing here sends ARM, COUNTDOWN or FIRE_CONFIRM over USB, and nothing here fires.

It needs no packages of its own: it re-runs itself under ground/venv (pyserial, PyYAML and
PyQt6 live there) and calls PlatformIO by its full path. Paths are always passed as argument
lists, never through a shell, so the spaces and the curly apostrophe in this folder's name are
harmless. ground/venv is deliberately not a dot-folder: this repo is iCloud-synced and files
in dot-folders get the macOS hidden flag, which stops Qt from loading its plugins.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import signal
import subprocess
import sys
import time
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path

REPO = Path(__file__).resolve().parent
VENV_DIR = REPO / "ground" / "venv"
VENV_PY = VENV_DIR / "bin" / "python"
PIO = Path.home() / ".platformio" / "penv" / "bin" / "pio"
STATE_FILE = REPO / "data" / "bringup_state.json"

TEENSY_VID = 0x16C0
FEATHER_VID = 0x239A
FEATHER_PID_FIRMWARE = 0x800B
FEATHER_PID_BOOTLOADER = 0x000B

# Paths whose contents change what gets built. Keep in step with build_inputs in
# firmware/pio_pregen_params.py, which uses the same list to decide "-dirty".
BUILD_INPUTS = [
    "core", "protocol", "params.yaml", "tools/gen_params.py", "tools/gen_protocol.py",
    "firmware/platformio.ini", "firmware/pio_pregen_params.py", "firmware/src", "firmware/test",
]

# Vehicle states in which flashing or re-running SELFTEST must not happen.
LIVE_STATES = {"ARMED", "COUNTDOWN", "IGNITE", "BURN", "TAILOFF"}

PERMANENT_RED = ("Firmware runs 1-state Kalman; paper/sim validated 2-state. "
                 "Merge pending.")

DOUBLE_TAP = ("double-tap the Feather's RESET button (two taps within half a second, the "
              "LED then pulses slowly), then run this command again right away")


# ---- output ----------------------------------------------------------------------------

_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
_CODES = {"PASS": "32", "GREEN": "32", "FAIL": "31", "RED": "31", "WARN": "33",
          "MANUAL": "33", "INFO": "36"}


def _tag(kind: str) -> str:
    text = f"{kind:<6}"
    return f"\033[{_CODES[kind]}m{text}\033[0m" if _COLOR and kind in _CODES else text


class Results:
    """Collects and prints PASS/FAIL lines. quiet=True stores them without printing."""

    def __init__(self, quiet: bool = False):
        self.quiet = quiet
        self.lines: list[tuple[str, str, str | None]] = []
        self.fails = 0

    def _add(self, kind: str, msg: str, nxt: str | None = None):
        self.lines.append((kind, msg, nxt))
        if not self.quiet:
            print(f"{_tag(kind)} {msg}")
            if nxt:
                print(f"       next: {nxt}")
            sys.stdout.flush()

    def passed(self, msg: str):
        self._add("PASS", msg)

    def failed(self, msg: str, nxt: str):
        self.fails += 1
        self._add("FAIL", msg, nxt)

    def warn(self, msg: str, nxt: str | None = None):
        self._add("WARN", msg, nxt)

    def info(self, msg: str):
        self._add("INFO", msg)

    @property
    def ok(self) -> bool:
        return self.fails == 0

    def print_all(self):
        for kind, msg, nxt in self.lines:
            print(f"{_tag(kind)} {msg}")
            if nxt:
                print(f"       next: {nxt}")


def die(msg: str, nxt: str, code: int = 2):
    r = Results()
    r.failed(msg, nxt)
    sys.exit(code)


# ---- bootstrap: run under ground/venv ----------------------------------------------------

def ensure_venv():
    if os.environ.get("TVC_NO_VENV"):
        return
    try:
        inside = Path(sys.prefix).resolve() == VENV_DIR.resolve()
    except OSError:
        inside = False
    if inside:
        return
    if VENV_PY.exists():
        os.execv(str(VENV_PY), [str(VENV_PY), str(Path(__file__).resolve()), *sys.argv[1:]])
    die("ground/venv not found",
        "python3 -m venv ground/venv && ground/venv/bin/python -m pip install "
        "-r ground/requirements.txt   (Python 3.11+; name it ground/venv, not a dot-folder)")


# ---- small helpers -----------------------------------------------------------------------

def run(cmd: list[str], cwd: Path = REPO, env: dict | None = None, timeout: float | None = None):
    full_env = dict(os.environ)
    if env:
        full_env.update(env)
    try:
        p = subprocess.run(cmd, cwd=str(cwd), capture_output=True, text=True, env=full_env,
                           timeout=timeout)
    except FileNotFoundError as exc:
        return 127, str(exc)
    except subprocess.TimeoutExpired as exc:
        out = (exc.stdout or b"")
        out = out.decode(errors="replace") if isinstance(out, bytes) else out
        return 124, out + f"\n(timed out after {timeout:.0f} s)"
    return p.returncode, (p.stdout or "") + (p.stderr or "")


def pio(args: list[str], timeout: float = 900):
    exe = str(PIO) if PIO.exists() else None
    if exe is None:
        from shutil import which
        exe = which("pio")
    if exe is None:
        return 127, f"PlatformIO not found at {PIO}"
    return run([exe, *args], cwd=REPO / "firmware", env={"TVC_PYTHON": sys.executable},
               timeout=timeout)


def tail(text: str, n: int = 12) -> str:
    return "\n".join("         " + ln for ln in text.strip().splitlines()[-n:])


def git_head() -> str:
    rc, out = run(["git", "rev-parse", "--short=12", "HEAD"])
    return out.strip() if rc == 0 else "unknown"


def git_dirty_inputs() -> bool:
    rc, out = run(["git", "status", "--porcelain", "--", *BUILD_INPUTS])
    return rc == 0 and bool(out.strip())


def hash_is_current(reported: str) -> tuple[bool, str]:
    """Does a hash a board reports correspond to what HEAD would build? (ok, explanation)"""
    head = git_head()
    base = reported.removesuffix("-dirty")
    if reported.endswith("-dirty"):
        return False, (f"{reported} was built from uncommitted changes to build inputs "
                       "(commit them, then reflash)")
    if base == head:
        return True, f"{reported} matches HEAD"
    rc, _ = run(["git", "cat-file", "-e", f"{base}^{{commit}}"])
    if rc != 0:
        return False, f"{reported} is not a commit in this repo (flashed from another checkout?)"
    rc, _ = run(["git", "diff", "--quiet", base, "HEAD", "--", *BUILD_INPUTS])
    if rc == 0:
        return True, f"{reported} differs from HEAD {head} only outside the build inputs"
    return False, f"{reported} is older than HEAD {head} and build inputs changed since"


def load_state() -> dict:
    try:
        return json.loads(STATE_FILE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(state: dict):
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n")


def load_params() -> dict:
    import yaml
    return yaml.safe_load((REPO / "params.yaml").read_text())


# ---- serial ports --------------------------------------------------------------------------

def all_ports():
    from serial.tools import list_ports
    return list(list_ports.comports())


def find_boards():
    ps = all_ports()
    return ([p for p in ps if p.vid == TEENSY_VID], [p for p in ps if p.vid == FEATHER_VID])


def describe_feather(p) -> str:
    if p.pid == FEATHER_PID_BOOTLOADER:
        return "Feather M0 in its bootloader (double-tap reset is active)"
    if p.pid == FEATHER_PID_FIRMWARE:
        return "Feather M0 running firmware"
    return "Adafruit board"


def port_holders(device: str) -> list[tuple[int, str, str]]:
    """(pid, short name, full command line) for every other process holding the device."""
    rc, out = run(["lsof", "-F", "pc", device], timeout=8)
    holders, pid = [], None
    for line in out.splitlines():
        if line.startswith("p") and line[1:].isdigit():
            pid = int(line[1:])
        elif line.startswith("c") and pid is not None and pid != os.getpid():
            _, cmdline = run(["ps", "-o", "command=", "-p", str(pid)], timeout=5)
            holders.append((pid, line[1:], cmdline.strip()))
    return holders


# Processes that are only watching a port and are safe to close for the user.
CLOSABLE = ("screen", "minicom", "picocom", "tio ", "miniterm", "pio device monitor",
            "platformio device monitor", "tvc monitor", "./tvc monitor", "telem_cli.py")


def free_port(r: Results, device: str) -> bool:
    """Close monitors holding the port; refuse (FAIL) if something else holds it."""
    holders = port_holders(device)
    if not holders:
        return True
    for pid, name, cmdline in holders:
        if any(marker in cmdline or marker.strip() == name for marker in CLOSABLE):
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
            r.info(f"closed {name} (pid {pid}) which was holding {device}")
        else:
            r.failed(f"{device} is busy: held by {name} (pid {pid}: {cmdline[:70]})",
                     f"close that program (for the ground station, close its window), then "
                     "run this again")
            return False
    time.sleep(1.0)
    if port_holders(device):
        r.failed(f"{device} is still busy after closing the monitor",
                 "close whatever has the port open (lsof " + device + " shows it) and retry")
        return False
    return True


def resolve_port(r: Results, kind: str, override: str | None) -> str | None:
    """Return the serial device for 'teensy' or 'feather', or print a FAIL and return None."""
    env_override = os.environ.get(f"TVC_{kind.upper()}_PORT")
    if override or env_override:
        return override or env_override
    teensy, feather = find_boards()
    found = teensy if kind == "teensy" else feather
    if len(found) > 1:
        names = ", ".join(p.device for p in found)
        r.failed(f"more than one {kind} serial port is present ({names})",
                 "unplug the extra board, or pass --port to say which one")
        return None
    if not found:
        if kind == "teensy":
            r.failed("Teensy not detected",
                     "plug in the Teensy with a data USB cable (charge-only cables have no "
                     "data lines); if it still does not show, press its program button once")
        else:
            r.failed("Feather not detected: try double-tap reset", DOUBLE_TAP)
        return None
    return found[0].device


class Console:
    """Line-oriented access to the Teensy's USB console (115200 baud)."""

    def __init__(self, port: str, baud: int = 115200):
        import serial
        self.ser = serial.Serial(port, baud, timeout=0.1)
        self._buf = b""

    def close(self):
        try:
            self.ser.close()
        except OSError:
            pass

    def send(self, line: str):
        self.ser.write(line.encode() + b"\n")
        self.ser.flush()

    def collect(self, stop_when=None, timeout: float = 5.0) -> tuple[list[str], bool]:
        lines: list[str] = []
        deadline = time.time() + timeout
        while time.time() < deadline:
            chunk = self.ser.read(256)
            if chunk:
                self._buf += chunk
            while b"\n" in self._buf:
                raw, self._buf = self._buf.split(b"\n", 1)
                line = raw.decode(errors="replace").rstrip("\r")
                lines.append(line)
                if stop_when and stop_when(line):
                    return lines, True
        return lines, False


STATUS_RE = re.compile(
    r"^\[(?P<state>[A-Z_]+)\] mode=(?P<mode>\S+) profile=(?P<profile>\S+) dry_run=(?P<dry>\d) "
    r"thrust=(?P<thrust>\S+)N enc=\((?P<ep>\S+),(?P<ey>\S+)\)deg arm_sw=(?P<arm>\S+) "
    r"cont=(?P<cont>\S+) fault_bits=0x(?P<faults>[0-9A-Fa-f]+) overruns=(?P<overruns>\d+)"
    r"(?: fw=(?P<fw>\S+))?"
    r"(?: loop_us_max=(?P<loop_us_max>\d+) tx_skipped=(?P<tx_skipped>\d+) "
    r"tx_timeouts=(?P<tx_timeouts>\d+))?")
BANNER_FW_RE = re.compile(r"firmware ready\. fw=(\S+)")


def query_status(con: Console, timeout: float = 3.0, tries: int = 3) -> dict | None:
    for _ in range(tries):
        con.ser.reset_input_buffer()
        con._buf = b""
        con.send("STATUS")
        lines, _ = con.collect(lambda ln: STATUS_RE.match(ln) is not None, timeout)
        for ln in lines:
            m = STATUS_RE.match(ln)
            if m:
                d = m.groupdict()
                d["faults"] = int(d["faults"], 16)
                d["overruns"] = int(d["overruns"])
                for key in ("loop_us_max", "tx_skipped", "tx_timeouts"):
                    if d.get(key) is not None:
                        d[key] = int(d[key])
                return d
    return None


# ---- generators and tests ----------------------------------------------------------------

def generate(r: Results) -> bool:
    ok = True
    for script in ("gen_params.py", "gen_protocol.py"):
        rc, out = run([sys.executable, str(REPO / "tools" / script)])
        if rc != 0:
            r.failed(f"tools/{script} failed",
                     "fix the error above it: " + (out.strip().splitlines() or ["?"])[-1])
            ok = False
    if ok:
        r.passed("generated core/params.h, core/measure_bits.json and protocol/event_codes.* "
                 "from params.yaml / event_codes.yaml")
    return ok


SUITE_RE = re.compile(r"^native\s+(\S+)\s+(PASSED|FAILED|ERRORED|SKIPPED)\b")
CASES_RE = re.compile(r"(\d+) test cases?: (\d+) succeeded")


def run_tests(r: Results) -> bool:
    if not generate(r):
        r.failed("remaining tests not run", "fix the generator error first")
        return False

    rc, out = run(["make", "-C", str(REPO / "core"), "native"])
    if rc == 0:
        r.passed("core/ builds as libtvccore.dylib (clang, the same code the firmware uses)")
    else:
        r.failed("core/ did not build", "needs clang: run `xcode-select --install`, then retry; "
                 "first error: " + next((ln for ln in out.splitlines() if "error" in ln),
                                        "see make -C core native"))

    rc, out = pio(["test", "-e", "native"], timeout=600)
    suites = [(m.group(1), m.group(2)) for ln in out.splitlines()
              if (m := SUITE_RE.match(ln.strip()))]
    bad = [name for name, status in suites if status != "PASSED"]
    cases = CASES_RE.search(out)
    if rc == 0 and suites and not bad:
        r.passed(f"native unit tests: {len(suites)} suites, {cases.group(2) if cases else '?'} "
                 "cases passed")
    elif rc == 127:
        r.failed("PlatformIO not found", f"install it, then expect it at {PIO}")
    else:
        what = ", ".join(bad) if bad else "build step"
        r.failed(f"native unit tests failed ({what})",
                 "run `cd firmware && ~/.platformio/penv/bin/pio test -e native -vv` and read "
                 "the first error")
        if not r.quiet:
            print(tail(out, 14))

    rc, out = run([sys.executable, str(REPO / "tools" / "parity_test.py")], timeout=600)
    last = (out.strip().splitlines() or [""])[-1]
    if rc == 0 and "PASS" in last:
        r.passed("parity: core/ via ctypes and via the firmware's native test are bitwise equal")
    else:
        r.failed("parity test failed: the simulation and firmware controllers differ",
                 "run `ground/venv/bin/python tools/parity_test.py` and read which step "
                 "differs first")
        if not r.quiet:
            print(tail(out, 10))

    r.info("running codec and GUI offscreen tests (about 45 s)")
    rc, out = run([sys.executable, "-m", "pytest", str(REPO / "ground" / "tests"), "-q"],
                  env={"QT_QPA_PLATFORM": "offscreen"}, timeout=900)
    summary = (out.strip().splitlines() or [""])[-1]
    if rc == 0:
        r.passed(f"codec and GUI offscreen tests: {summary}")
    else:
        r.failed(f"codec/GUI tests failed ({summary})",
                 "run `ground/venv/bin/python -m pytest ground/tests -x -q` and read the "
                 "first failure")
        if not r.quiet:
            print(tail(out, 14))
    return r.ok


def cmd_test(_args) -> int:
    r = Results()
    ok = run_tests(r)
    print()
    print("ALL TESTS PASSED" if ok else f"{r.fails} FAILED")
    return 0 if ok else 1


# ---- ports ---------------------------------------------------------------------------------

def cmd_ports(_args) -> int:
    r = Results()
    teensy, feather = find_boards()
    for p in teensy:
        r.passed(f"Teensy found: {p.device} ({p.description}, {p.vid:04X}:{p.pid:04X})")
        for pid, name, _ in port_holders(p.device):
            r.warn(f"{p.device} is open in {name} (pid {pid})",
                   "./tvc flash and ./tvc selftest need it free; close that program")
    if not teensy:
        r.failed("Teensy not detected",
                 "plug in the Teensy with a data USB cable (charge-only cables have no data "
                 "lines); if it still does not show, press its program button once")
    for p in feather:
        r.passed(f"Feather found: {p.device} ({describe_feather(p)}, "
                 f"{p.vid:04X}:{p.pid:04X})")
        for pid, name, _ in port_holders(p.device):
            r.warn(f"{p.device} is open in {name} (pid {pid})",
                   "close that program before flashing or running ./tvc link")
        if p.pid == FEATHER_PID_BOOTLOADER:
            r.warn("the Feather is sitting in its bootloader, not running the bridge firmware",
                   "press RESET once to leave it, or run ./tvc flash feather to upload now")
    if not feather:
        r.failed("Feather not detected: try double-tap reset", DOUBLE_TAP)
    others = [p.device for p in all_ports() if p.vid not in (TEENSY_VID, FEATHER_VID)]
    if others:
        r.info("ignored other serial ports: " + ", ".join(others))
    print()
    print("BOTH BOARDS PRESENT" if r.ok else f"{r.fails} MISSING")
    return 0 if r.ok else 1


# ---- flash ---------------------------------------------------------------------------------

def wait_for_port(kind: str, timeout: float, feather_pid: int | None = None) -> str | None:
    deadline = time.time() + timeout
    while time.time() < deadline:
        teensy, feather = find_boards()
        found = teensy if kind == "teensy" else feather
        if feather_pid is not None:
            found = [p for p in found if p.pid == feather_pid]
        if found:
            return found[0].device
        time.sleep(0.5)
    return None


def read_teensy_hash(device: str, timeout: float = 45.0) -> tuple[str | None, list[str]]:
    """Wait for the Teensy to finish booting and report its hash. Returns (hash, seen lines)."""
    seen: list[str] = []
    try:
        con = Console(device)
    except OSError:
        return None, seen
    try:
        deadline = time.time() + timeout
        while time.time() < deadline:
            lines, _ = con.collect(timeout=1.5)
            seen += lines
            for ln in lines:
                m = BANNER_FW_RE.search(ln)
                if m:
                    return m.group(1), seen
            con.send("STATUS")
            more, _ = con.collect(lambda ln: STATUS_RE.match(ln) is not None, 2.0)
            seen += more
            for ln in more:
                m = STATUS_RE.match(ln)
                if m and m.group("fw"):
                    return m.group("fw"), seen
        return None, seen
    finally:
        con.close()


def flash_teensy(r: Results, port_override: str | None) -> bool:
    if not generate(r):
        return False
    dev = resolve_port(r, "teensy", port_override)
    if not dev:
        return False
    if not free_port(r, dev):
        return False

    try:
        con = Console(dev)
        st = query_status(con, timeout=1.5, tries=1)
        con.close()
    except OSError:
        st = None
    if st and st["state"] in LIVE_STATES:
        r.failed(f"the vehicle is {st['state']}: refusing to flash it",
                 "send ABORT first (./tvc monitor teensy, then type ABORT), then flash")
        return False

    r.info("building and uploading teensy_flight (about 30 s); on boot the board sweeps both "
           "servos +-5 deg, so keep the linkage clear")
    rc, out = pio(["run", "-e", "teensy_flight", "-t", "upload"], timeout=900)
    if rc != 0:
        r.failed("teensy_flight build or upload failed",
                 "read the last lines below; if the build passed and upload failed, press the "
                 "Teensy's program button once and run this again")
        print(tail(out, 14))
        return False
    r.passed("teensy_flight built and uploaded")

    new_dev = wait_for_port("teensy", 25.0)
    if not new_dev:
        r.failed("the Teensy did not come back on USB after the upload",
                 "unplug and replug it, then run ./tvc ports")
        return False
    r.info("waiting for the Teensy to boot and finish SELFTEST (up to 45 s)")
    reported, seen = read_teensy_hash(new_dev)
    if not reported:
        r.failed("the Teensy booted but never reported a firmware hash",
                 "open ./tvc monitor teensy and send STATUS; if there is no fw= field the "
                 "upload did not take, so run ./tvc flash teensy again")
        return False
    ok, why = hash_is_current(reported)
    if ok:
        r.passed(f"Teensy reports firmware {why}")
    else:
        r.failed(f"Teensy reports firmware {why}", "run ./tvc flash teensy again")
        return False
    if any("SELFTEST: complete" in ln for ln in seen):
        r.passed("boot SELFTEST completed (run ./tvc selftest for one line per check)")
    elif any("SELFTEST: FAULT" in ln for ln in seen):
        r.warn("boot SELFTEST ended in FAULT", "run ./tvc selftest to see which check failed")
    return True


def flash_feather(r: Results, port_override: str | None) -> bool:
    if not generate(r):
        return False
    dev = resolve_port(r, "feather", port_override)
    if not dev:
        return False
    if not free_port(r, dev):
        return False

    r.info("building and uploading feather_bridge (about 30 s)")
    rc, out = pio(["run", "-e", "feather_bridge", "-t", "upload", "--upload-port", dev],
                  timeout=900)
    if rc != 0:
        r.failed("feather_bridge build or upload failed", DOUBLE_TAP)
        print(tail(out, 14))
        return False
    r.passed("feather_bridge built and uploaded (bossac wrote and verified the flash)")

    new_dev = wait_for_port("feather", 20.0, FEATHER_PID_FIRMWARE)
    if not new_dev:
        r.failed("the Feather did not re-appear running the bridge firmware",
                 "press RESET once; if ./tvc ports still shows only the bootloader, "
                 "run ./tvc flash feather again")
        return False
    r.passed(f"Feather is running the bridge firmware on {new_dev}")

    state = load_state()
    head = git_head()
    state["feather"] = {"hash": head + ("-dirty" if git_dirty_inputs() else ""),
                        "port": new_dev,
                        "time": datetime.now(timezone.utc).isoformat(timespec="seconds")}
    save_state(state)
    r.info("the bridge only relays radio frames, so it cannot report its own hash; the upload "
           f"verification above plus the stamp for {state['feather']['hash']} stand in for it")
    return True


def cmd_flash(args) -> int:
    r = Results()
    if args.target == "teensy":
        ok = flash_teensy(r, args.port)
    elif args.target == "feather":
        ok = flash_feather(r, args.port)
    else:
        if args.port:
            die("--port cannot be used with 'flash all'",
                "flash each board separately with --port, or let both auto-detect")
        ok_t = flash_teensy(r, None)
        ok_f = flash_feather(r, None)
        ok = ok_t and ok_f
        print()
        print(f"Teensy:  {'on current firmware' if ok_t else 'NOT verified'}")
        print(f"Feather: {'on current firmware' if ok_f else 'NOT verified'}")
    return 0 if ok else 1


